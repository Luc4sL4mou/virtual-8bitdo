<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10: traz o tema Fluent (visual Windows 11) do WPF, e o .NET 8 sai de suporte em nov/2026. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms só para o NotifyIcon (ícone da bandeja), que o WPF não tem. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- O tema Fluent do WPF ainda é marcado como "experimental". -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Evita conflito de nomes entre WPF e WinForms (Application, Button...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Virtual8BitDo.Input\Virtual8BitDo.Input.csproj" />
    <ProjectReference Include="..\Virtual8BitDo.Catalog\Virtual8BitDo.Catalog.csproj" />
    <ProjectReference Include="..\Virtual8BitDo.Core\Virtual8BitDo.Core.csproj" />
    <ProjectReference Include="..\Virtual8BitDo.Output\Virtual8BitDo.Output.csproj" />
  </ItemGroup>

</Project>
