<Window x:Class="Virtual8BitDo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Virtual8BitDo.App.Views"
        xmlns:services="clr-namespace:Virtual8BitDo.App.Services"
        Title="Virtual 8BitDo" Width="1280" Height="960" MinWidth="1000" MinHeight="680"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource BgBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <!-- "Chip" de botão cru: neutro normal, degradê quando pressionado. -->
        <Style x:Key="RawChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Ícone de bateria: contorno + preenchimento proporcional ao nível (cor muda com o nível). -->
        <DataTemplate x:Key="BatteryIcon">
            <Grid Width="24" Height="12" VerticalAlignment="Center">
                <Border BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1.3" CornerRadius="3" Margin="0,0,2.5,0">
                    <Grid>
                        <Border Background="{Binding BatteryBrush}" Margin="1.3" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding BatteryFraction}"/>
                            </Border.RenderTransform>
                        </Border>
                        <!-- Raio vetorial, centralizado no corpo da bateria (emoji ⚡ desalinhava). -->
                        <Path Data="M4.5,0 L0,5.5 L2.8,5.5 L1.8,10 L6.5,3.8 L3.7,3.8 Z" Width="4.5" Height="6.5" Stretch="Fill"
                              Fill="White" Stroke="#1B1D21" StrokeThickness="0.6" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="{Binding IsCharging, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource TextSecondaryBrush}" Width="1.8" Height="5" CornerRadius="0,1,1,0" HorizontalAlignment="Right"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,0,20,10"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Bolinha de status: verde quando ativo, cinza quando não. -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,5,8,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Seletor de tema (Escuro | Claro): par de botões de opção em formato de pílula. -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Padding="10,6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedItemBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão branco sobre o cartão colorido do jogo. -->
        <Style x:Key="HeroButton" TargetType="Button">
            <Setter Property="Foreground" Value="#16300A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Padding="14,8" Background="White">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EEFBDD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cabeçalho de cartão: selo com ícone + título + subtítulo. -->
        <Style x:Key="CardHeader" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Fundo com brilhos suaves -->
        <Rectangle Fill="{DynamicResource BgGlow1Brush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource BgGlow2Brush}" IsHitTestVisible="False"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== Barra lateral: marca + controles conectados + controle virtual + tema ========== -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="18,20,18,16">
                    <!-- Marca -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,26">
                        <!-- Ícone do app (o mesmo da barra de tarefas), na resolução maior para ficar nítido. -->
                        <Image Source="{x:Static services:AppIcon.Large}" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Virtual 8BitDo" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="Central do seu controle" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Rodapé: tema + catálogo -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <Border DockPanel.Dock="Right" Padding="3" CornerRadius="10" Background="{DynamicResource ChipBrush}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="DarkThemeOption" Style="{StaticResource SegmentRadio}" GroupName="Theme" Checked="Theme_Checked"
                                             ToolTip="Tema escuro" AutomationProperties.Name="Tema escuro">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="14"/>
                                </RadioButton>
                                <RadioButton x:Name="LightThemeOption" Style="{StaticResource SegmentRadio}" GroupName="Theme" Checked="Theme_Checked"
                                             ToolTip="Tema claro" AutomationProperties.Name="Tema claro">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="14"/>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                    </DockPanel>

                    <!-- Controle virtual Xbox 360 (ViGEmBus) + HidHide -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Forwarding}"
                                              VerticalAlignment="Center" ToolTip="Repassar o controle físico para o controle virtual Xbox 360"/>
                                <StackPanel>
                                    <TextBlock Text="Controle virtual" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Os jogos veem um Xbox 360" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource Surface}" Padding="12,10" Margin="0,12,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <Ellipse Style="{StaticResource StatusDot}" Tag="{Binding IsVirtualActive}"/>
                                        <TextBlock Text="{Binding VirtualStatusText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,6,0,0">
                                        <Ellipse Style="{StaticResource StatusDot}" Tag="{Binding IsHiding}"/>
                                        <TextBlock Text="{Binding HidHideStatusText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Instalação dos drivers pela fonte oficial (aparece só quando falta algum) -->
                            <Button Style="{StaticResource GradientButton}" Click="InstallViGEm_Click" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding CanInstall}" Visibility="{Binding IsViGEmMissing, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Baixa o instalador oficial do GitHub da Nefarius e confere a assinatura digital antes de abrir.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Instalar ViGEmBus (oficial)"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GradientButton}" Click="InstallHidHide_Click" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding CanInstall}" Visibility="{Binding IsHidHideMissing, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Baixa o instalador oficial do GitHub da Nefarius e confere a assinatura digital antes de abrir.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Instalar HidHide (oficial)"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding InstallStatus}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" Margin="0,8,0,0"
                                       Visibility="{Binding HasInstallStatus, Converter={StaticResource BoolToVis}}"/>

                            <Button Style="{StaticResource GhostButton}" Click="RestorePhysical_Click" AutomationProperties.Name="Restaurar controle físico" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                    ToolTip="Desliga o repasse e mostra o controle físico de novo para os jogos.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="Restaurar controle físico"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Controles conectados -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,0">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="0,0,2,10" Padding="8,1" VerticalAlignment="Top">
                            <TextBlock Text="{Binding ControllerCount}" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="CONTROLES CONECTADOS" Style="{StaticResource SectionLabel}"/>
                    </DockPanel>

                    <Border DockPanel.Dock="Top" CornerRadius="14" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" Padding="16"
                            Visibility="{Binding HasNoControllers, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="28" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"
                                       Text="Nenhum controle detectado. Conecte por cabo, Bluetooth ou dongle e aguarde alguns segundos."/>
                        </StackPanel>
                    </Border>

                    <ListBox ItemsSource="{Binding Controllers}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource ControllerItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconBadge}" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding ConnectionGlyph}" FontSize="18"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Border Style="{StaticResource Pill}" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding ConnectionMode}"/>
                                            </Border>
                                            <Border Style="{StaticResource Pill}" Margin="0,0,6,4"
                                                    Visibility="{Binding ShowBattery, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource BatteryIcon}"/>
                                                    <TextBlock Text="{Binding BatteryText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding VidPidText}" Foreground="{DynamicResource TextTertiaryBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ========== Área principal ========== -->
            <DockPanel Grid.Column="1" Margin="26,20,26,16">

                <!-- Cartão do jogo em foco: mostra o que foi detectado e qual perfil entrou sozinho. -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,18" DataContext="{Binding Profiles}">
                    <!-- Sombra colorida, numa camada fora do recorte -->
                    <Border CornerRadius="20" Background="{DynamicResource BgBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource HeroShadowColor}" BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.3"/>
                        </Border.Effect>
                    </Border>
                    <!-- Recorte arredondado aplicado no código (HeroClip.SizeChanged) -->
                    <Grid x:Name="HeroClip">
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource HeroIdleBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGame}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HeroBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <!-- Anéis decorativos -->
                    <Ellipse Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-90,-70,-90"
                             Stroke="#2EFFFFFF" StrokeThickness="28" IsHitTestVisible="False"/>
                    <Ellipse Width="120" Height="120" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-50,190,0"
                             Fill="#24FFFFFF" IsHitTestVisible="False"/>

                    <Grid Margin="22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="68" Height="68" CornerRadius="18" Background="#4DFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="30" Foreground="{DynamicResource OnAccentBrush}"/>
                                <Image Source="{Binding GameIcon}" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource PulseDot}" Fill="{DynamicResource OnAccentBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="EM FOCO AGORA · DETECÇÃO AUTOMÁTICA" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentSoftBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding GameName}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource OnAccentBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Border CornerRadius="6" Background="#1F0B1A05" Padding="7,1" Margin="0,0,10,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding GameExe}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{DynamicResource OnAccentBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding ActiveText}" Foreground="{DynamicResource OnAccentSoftBrush}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Lado a lado: o botão "Criar perfil" aparece sem mudar a altura do cartão. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border CornerRadius="14" Background="#4DFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" Padding="16,10" MinWidth="150">
                                <StackPanel>
                                    <TextBlock Text="PERFIL ATIVO" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentSoftBrush}"/>
                                    <TextBlock Text="{Binding ActiveName}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource HeroButton}" Click="NewProfileForGame_Click" AutomationProperties.Name="Criar perfil deste jogo" Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding CanCreateForGame, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Cria um perfil para o jogo em foco: daqui em diante ele entra sozinho.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Criar perfil deste jogo"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    </Grid>
                </Grid>

                <TabControl Style="{StaticResource NavTabs}">

                    <!-- ===== Aba 1: Mapeamento (perfis, turbo, editor visual) ===== -->
                    <TabItem AutomationProperties.Name="Mapeamento" Header="Mapeamento" Tag="&#xE7FC;">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,8" DataContext="{Binding Profiles}">

                                <!-- Perfil + Turbo lado a lado -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="330"/>
                                    </Grid.ColumnDefinitions>

                                <!-- Perfil -->
                                <Border Style="{StaticResource Card}" Margin="0">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource CardHeader}">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource GradientButton}" Click="NewProfile_Click" AutomationProperties.Name="Novo perfil"
                                                        ToolTip="Cria um perfil: você escolhe o jogo na lista de programas abertos.">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Novo perfil"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Click="DuplicateProfile_Click" AutomationProperties.Name="Duplicar perfil" Margin="8,0,0,0" Padding="9,8"
                                                        ToolTip="Duplicar este perfil">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="14"/>
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Click="DeleteProfile_Click" AutomationProperties.Name="Apagar perfil" Margin="6,0,0,0" Padding="9,8"
                                                        IsEnabled="{Binding CanChangeExe}" ToolTip="Apagar este perfil">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14"/>
                                                </Button>
                                            </StackPanel>
                                            <Border Style="{StaticResource IconBadge}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;"/>
                                            </Border>
                                            <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource CardTitle}" Text="Perfis"/>
                                                <TextBlock Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Text="Um perfil por jogo. Nos outros programas vale o Padrão."/>
                                            </StackPanel>
                                        </DockPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Editando"/>
                                                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Editing}" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Nome"/>
                                                <TextBox Text="{Binding EditingName, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Jogo associado" Margin="2,14,0,6"/>
                                        <Border Style="{StaticResource Surface}" Padding="8"
                                                ToolTip="O perfil é ativado sozinho quando este jogo estiver em foco.">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            Visibility="{Binding CanChangeExe, Converter={StaticResource BoolToVis}}">
                                                    <Button Style="{StaticResource GhostButton}" Click="ChooseGame_Click" AutomationProperties.Name="Escolher jogo">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="13" Margin="0,0,8,0"/>
                                                            <TextBlock Text="Escolher jogo..."/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource GhostButton}" Click="RemoveGame_Click" AutomationProperties.Name="Remover jogo" Margin="6,0,0,0" Padding="9,8"
                                                            Visibility="{Binding HasEditingExe, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Tira o jogo deste perfil: ele deixa de ser ativado sozinho.">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12"/>
                                                    </Button>
                                                </StackPanel>
                                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource ChipBrush}" Margin="2,0,12,0">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding EditingGameText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Style="{StaticResource Caption}" Margin="2,10,0,0"
                                                   Visibility="{Binding IsEditingDefault, Converter={StaticResource BoolToVis}}"
                                                   Text="Perfil padrão: usado quando o jogo em foco não tem um perfil próprio. Não pode ser apagado nem associado a um jogo."/>
                                    </StackPanel>
                                </Border>

                                <!-- Turbo -->
                                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Margin="0,0,0,6">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TurboHz}" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentGradientTextBrush}"/>
                                                <TextBlock Text="Hz" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Bottom" Margin="5,0,0,9"/>
                                            </StackPanel>
                                            <Border Style="{StaticResource IconBadge}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE945;"/>
                                            </Border>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Turbo" Margin="12,0,0,0"/>
                                        </DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="Quantas vezes por segundo um botão com turbo aperta e solta."/>
                                        <Slider DockPanel.Dock="Top" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TurboHz}" Margin="0,12,0,0"/>
                                        <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"
                                                   Text="{Binding DataContext.MeasuredTurboText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="10" Padding="12,10" VerticalAlignment="Bottom" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="No controle" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="19">
                                                    <Bold>Home + ↑/↓</Bold> ±1 Hz · <Bold>Home + →/←</Bold> ±5 Hz<LineBreak/>
                                                    <Bold>Home + botão</Bold> liga/desliga o turbo dele
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>
                                </Border>
                                </Grid>

                                <!-- Editor visual -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource CardHeader}">
                                            <!-- Legenda (à direita do título) -->
                                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Border Style="{StaticResource Pill}" Margin="0,2,6,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="9" Height="9" Stroke="{DynamicResource WarnBrush}" StrokeThickness="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="alterado"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource Pill}" Margin="0,2,6,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="A" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="turbo"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource Pill}" Margin="0,2,6,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="9" Height="9" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.3" StrokeDashArray="2,1.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="o controle não envia no modo atual"/>
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>
                                            <Border Style="{StaticResource IconBadge}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE765;"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource CardTitle}" Text="Botões"/>
                                                <TextBlock Style="{StaticResource Caption}" Text="Clique em um botão do desenho para escolher o que ele faz."/>
                                            </StackPanel>
                                        </DockPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="300"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Background="{DynamicResource DiagramStageBrush}" CornerRadius="14" Padding="8,12">
                                                <views:ControllerDiagram x:Name="Diagram" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                            </Border>

                                            <!-- Editor do botão selecionado -->
                                            <Border Grid.Column="1" Style="{StaticResource Surface}" Padding="18" Margin="14,0,0,0">
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center" Visibility="{Binding HasNoEditor, Converter={StaticResource BoolToVis}}">
                                                        <Border Style="{StaticResource IconBadge}" Width="52" Height="52" CornerRadius="16" Margin="0,0,0,12">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B0;" FontSize="22"/>
                                                        </Border>
                                                        <TextBlock Text="Nenhum botão selecionado" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,4,0,0"
                                                                   Text="Clique em um botão no desenho do controle para mudar a função dele ou ligar o turbo."/>
                                                    </StackPanel>
                                                    <StackPanel DataContext="{Binding Editor}"
                                                                Visibility="{Binding DataContext.HasEditor, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="BOTÃO SELECIONADO" FontSize="10.5" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentGradientTextBrush}" Margin="2,0,0,14"/>

                                                        <Border Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1"
                                                                CornerRadius="10" Padding="10,8" Margin="0,0,0,12"
                                                                Visibility="{Binding IsUnavailableNow, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}" FontSize="12"
                                                                       Text="O controle não envia este botão no modo de conexão atual. A configuração fica salva e passa a valer quando ele estiver disponível (ex.: Bluetooth)."/>
                                                        </Border>

                                                        <TextBlock Text="Ação" Style="{StaticResource FieldLabel}"/>
                                                        <ComboBox ItemsSource="{Binding KindOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                  SelectedValue="{Binding Kind}" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>

                                                        <StackPanel Visibility="{Binding IsXbox, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Botão do Xbox" Style="{StaticResource FieldLabel}"/>
                                                            <ComboBox ItemsSource="{Binding XboxOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                      SelectedValue="{Binding Xbox1}" Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
                                                            <TextBlock Text="Junto com (opcional)" Style="{StaticResource FieldLabel}"/>
                                                            <ComboBox ItemsSource="{Binding SecondXboxOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                      SelectedValue="{Binding Xbox2}" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>
                                                        </StackPanel>

                                                        <StackPanel Visibility="{Binding IsKey, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Tecla" Style="{StaticResource FieldLabel}"/>
                                                            <ComboBox ItemsSource="{Binding KeyOptions}" SelectedItem="{Binding Key}" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>
                                                            <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,12"
                                                                       Text="Na tela de configuração de controles do jogo, aperte este botão: o jogo grava a tecla escolhida."/>
                                                        </StackPanel>

                                                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="10" Padding="12,10"
                                                                ToolTip="Enquanto segurado, o botão é apertado e solto repetidamente na frequência do turbo.">
                                                            <DockPanel>
                                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Turbo}"/>
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="14" Foreground="{DynamicResource WarnBrush}" Margin="0,0,10,0"/>
                                                                <TextBlock Text="Turbo" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </DockPanel>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" Margin="2,14,0,0">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                                                            <TextBlock Style="{StaticResource Caption}" Text="Salvo automaticamente"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Aba 2: Controle (informações e diagnóstico do controle selecionado) ===== -->
                    <TabItem AutomationProperties.Name="Controle" Header="Controle" Tag="&#xE9D9;">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="36" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="Selecione ou conecte um controle." Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="0,0,6,8" DataContext="{Binding Selected}">

                                    <Border Style="{StaticResource Card}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,16,0">
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding ConnectionGlyph}" FontSize="28" Foreground="{DynamicResource OnAccentBrush}"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ModelText}" FontSize="13" Foreground="{DynamicResource AccentTextBrush}" Margin="0,2,0,8"/>
                                                <WrapPanel>
                                                    <Border Style="{StaticResource Pill}">
                                                        <TextBlock Text="{Binding ConnectionMode}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}" Visibility="{Binding ShowBattery, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource BatteryIcon}"/>
                                                            <TextBlock Text="{Binding BatteryText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}">
                                                        <TextBlock Text="{Binding VidPidText}" FontFamily="Cascadia Mono, Consolas"/>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- Aviso de modelo desconhecido + escolha manual -->
                                    <Border Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBorderBrush}"
                                            BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,14"
                                            Visibility="{Binding IsUnknown, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="20" Foreground="{DynamicResource WarnBrush}"
                                                       VerticalAlignment="Top" Margin="0,0,14,0"/>
                                            <StackPanel>
                                                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="Modelo não está no catálogo (models.json)."/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,10" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="Escolha manualmente o que este controle possui. Para cadastrá-lo de vez, use o VID/PID acima."/>
                                                <ComboBox ItemsSource="{Binding ManualChoices}" SelectedItem="{Binding ManualModel}"
                                                          DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- Observação do catálogo sobre este modelo/modo (ex.: botões extras indisponíveis) -->
                                    <Border Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1"
                                            CornerRadius="16" Padding="18" Margin="0,0,0,14"
                                            Visibility="{Binding HasModelNote, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="20" Foreground="{DynamicResource InfoBrush}"
                                                       VerticalAlignment="Top" Margin="0,0,14,0"/>
                                            <TextBlock Text="{Binding ModelNote}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Dispositivo -->
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <DockPanel Style="{StaticResource CardHeader}">
                                                <Border Style="{StaticResource IconBadge}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE950;"/>
                                                </Border>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="Dispositivo" Margin="12,0,0,0"/>
                                            </DockPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Style="{StaticResource InfoLabel}" Text="VID / PID"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding VidPidText}" FontFamily="Cascadia Mono, Consolas"/>
                                                <TextBlock Grid.Row="1" Style="{StaticResource InfoLabel}" Text="Conexão"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding ConnectionMode}"/>
                                                <TextBlock Grid.Row="2" Style="{StaticResource InfoLabel}" Text="Windows vê"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding RawCountsText}"/>
                                                <TextBlock Grid.Row="3" Style="{StaticResource InfoLabel}" Text="Modo SDL"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding GamepadSupportText}"/>
                                                <TextBlock Grid.Row="4" Style="{StaticResource InfoLabel}" Text="Caminho"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding PathText}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Row="5" Style="{StaticResource InfoLabel}" Text="Bateria"
                                                           Visibility="{Binding ShowBattery, Converter={StaticResource BoolToVis}}"/>
                                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10"
                                                            Visibility="{Binding ShowBattery, Converter={StaticResource BoolToVis}}">
                                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource BatteryIcon}"/>
                                                    <TextBlock Text="{Binding BatteryText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="6" Style="{StaticResource InfoLabel}" Text="Detalhes"
                                                           Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding DiagnosticText}"
                                                           FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Botões crus -->
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <DockPanel Style="{StaticResource CardHeader}">
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="0" VerticalAlignment="Center">
                                                    <TextBlock>
                                                        <Run Text="último:" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                        <Run Text="{Binding LastRawPressed, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </TextBlock>
                                                </Border>
                                                <Border Style="{StaticResource IconBadge}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B0;"/>
                                                </Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource CardTitle}" Text="Botões que o Windows enxerga"/>
                                                    <TextBlock Style="{StaticResource Caption}" Text="Aperte no controle: o botão acende aqui."/>
                                                </StackPanel>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding RawButtons}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource RawChip}">
                                                            <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Eixos -->
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <DockPanel Style="{StaticResource CardHeader}">
                                                <Border Style="{StaticResource IconBadge}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;"/>
                                                </Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource CardTitle}" Text="Eixos"/>
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding HatsText, StringFormat='Analógicos e gatilhos · {0}'}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Axes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="70"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="65535" Height="6" VerticalAlignment="Center"
                                                                         Value="{Binding Progress, Mode=OneWay}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Value}" TextAlignment="Right" FontFamily="Cascadia Mono, Consolas"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ===== Aba 3: Dicas ===== -->
                    <TabItem AutomationProperties.Name="Dicas" Header="Dicas" Tag="&#xEA80;">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,8">
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource IconBadge}" VerticalAlignment="Top" Margin="0,0,14,0">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE702;"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Modos de conexão do 8BitDo Ultimate 2" Margin="0,6,0,8"/>
                                            <TextBlock Style="{StaticResource Body}">
                                                • <Bold>Bluetooth</Bold>: todos os botões chegam ao PC, inclusive L4, R4, PL e PR. Bateria em % exata.<LineBreak/>
                                                • <Bold>Dongle 2.4G</Bold>: menor atraso, mas o controle fala o protocolo do Xbox 360 e os botões extras não chegam ao PC.<LineBreak/>
                                                • <Bold>Cabo USB</Bold>: igual ao dongle, e carrega a bateria.<LineBreak/>
                                                Para usar os botões extras, conecte por Bluetooth. Para reconectar, aperte só o Home (segurar o botão de pareamento cria um pareamento novo).
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource IconBadge}" VerticalAlignment="Top" Margin="0,0,14,0">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE765;"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Dar uma função aos botões extras dentro do jogo" Margin="0,6,0,8"/>
                                            <TextBlock Style="{StaticResource Body}">
                                                1. Na aba Mapeamento, clique no botão extra (ex.: PL) e escolha "Tecla do teclado" (ex.: F13).<LineBreak/>
                                                2. No jogo, abra a tela de configuração de controles/teclas e escolha a ação que você quer.<LineBreak/>
                                                3. Aperte o PL no controle: o jogo grava a tecla, e a partir daí o PL faz aquela ação.<LineBreak/>
                                                Se o jogo não aceitar a tecla F13–F24, escolha outra tecla que o jogo não use.
                                                Também dá para fazer o PL apertar um botão do Xbox (ex.: A), ou dois juntos (ex.: LB + A).
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource IconBadge}" VerticalAlignment="Top" Margin="0,0,14,0">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Turbo" Margin="0,6,0,8"/>
                                            <TextBlock Style="{StaticResource Body}">
                                                Com turbo, segurar o botão equivale a apertar e soltar várias vezes por segundo.<LineBreak/>
                                                • Na interface: aba Mapeamento → clique no botão → ligue "Turbo"; a frequência fica no cartão Turbo.<LineBreak/>
                                                • No controle: segure <Bold>Home</Bold> e aperte o botão para ligar/desligar o turbo dele;
                                                segure Home e use ↑/↓ (±1 Hz) ou →/← (±5 Hz) para mudar a frequência.<LineBreak/>
                                                Um aviso flutuante mostra o nível na hora. Apertar Home sozinho continua funcionando como Home.
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource IconBadge}" VerticalAlignment="Top" Margin="0,0,14,0">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Perfis por jogo" Margin="0,6,0,8"/>
                                            <TextBlock Style="{StaticResource Body}">
                                                Abra o jogo e volte ao Virtual 8BitDo: o cartão do topo mostra o jogo detectado. Clique em "Criar perfil deste jogo"
                                                (ou em "Novo perfil" e escolha na lista). A partir daí, sempre que o jogo estiver em foco o perfil dele entra sozinho,
                                                com um aviso flutuante; ao fechar o jogo ou trocar para outro programa, volta o Padrão.
                                                Os perfis ficam em %AppData%\Virtual8BitDo\profiles (um arquivo por perfil).
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource IconBadge}" VerticalAlignment="Top" Margin="0,0,14,0">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Se algo der errado" Margin="0,6,0,8"/>
                                            <TextBlock Style="{StaticResource Body}">
                                                • O jogo não reage ao controle: alguns jogos antigos só leem o "jogador 1"; com o dongle, o controle virtual pode ser o jogador 2.<LineBreak/>
                                                • Botões duplicados em jogos da Steam: desative o Steam Input para aquele jogo.<LineBreak/>
                                                • O controle sumiu dos jogos: clique em "Restaurar controle físico" (ou feche o app pelo menu da bandeja).
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
