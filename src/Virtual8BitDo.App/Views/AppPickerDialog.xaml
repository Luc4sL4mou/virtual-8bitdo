<Window x:Class="Virtual8BitDo.App.Views.AppPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Virtual8BitDo.App.Services"
        Title="Escolher jogo" Width="580" Height="560" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource BgBrush}" TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <!-- Escolha do jogo para um perfil: lista dos programas abertos (com ícone), busca, ou procurar o .exe no disco. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisApp"/>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <Image Source="{x:Static services:AppIcon.Large}" Width="42" Height="42" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="Heading" FontSize="19" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="Hint" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,14"
                       Text="Abra o jogo antes, para ele aparecer na lista. Os usados por último aparecem primeiro."/>
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="Atualizar" Click="Refresh_Click" Margin="8,0,0,0"/>
                <Grid>
                    <TextBox x:Name="Search" TextChanged="Search_TextChanged"/>
                    <TextBlock Text="Buscar pelo nome..." IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Procurar .exe..." Click="Browse_Click"
                    ToolTip="Escolher o executável do jogo no disco (para jogos que não estão abertos agora)."/>
            <Button x:Name="NoGameButton" DockPanel.Dock="Left" Content="Perfil sem jogo" Click="NoGame_Click" Margin="8,0,0,0"
                    ToolTip="Cria um perfil que só é usado quando você o escolhe; não troca sozinho."/>
            <Button x:Name="ConfirmButton" DockPanel.Dock="Right" MinWidth="120" IsDefault="True" Click="Confirm_Click" IsEnabled="False"
                    Style="{StaticResource GradientButton}"/>
            <Button DockPanel.Dock="Right" Content="Cancelar" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
        </DockPanel>

        <Grid>
            <ListBox x:Name="Apps" SelectionChanged="Apps_SelectionChanged" MouseDoubleClick="Apps_MouseDoubleClick"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Padding="6">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="4,7">
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource ChipBrush}" Margin="0,0,12,0">
                                <Image Source="{Binding App.Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding App.DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ExistingProfile}" FontSize="12" Foreground="{DynamicResource WarnBrush}"
                                           Visibility="{Binding HasExistingProfile, Converter={StaticResource BoolToVisApp}}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Text="Nenhum programa aberto encontrado. Abra o jogo e clique em Atualizar, ou use Procurar .exe."
                       TextWrapping="Wrap" TextAlignment="Center" Margin="40" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextTertiaryBrush}" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
