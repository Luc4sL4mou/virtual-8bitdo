<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema escuro (padrão). As mesmas chaves existem em Colors.Light.xaml; o ThemeManager troca um pelo outro. -->

    <!-- Destaque do app: verde-limão fluorescente, o mesmo tom do ícone. Também substitui a cor de destaque do Windows. -->
    <Color x:Key="AccentColor">#A2E640</Color>

    <Color x:Key="SystemAccentColor">#6CC51E</Color>
    <Color x:Key="SystemAccentColorLight1">#8EDB2C</Color>
    <Color x:Key="SystemAccentColorLight2">#A8EC4A</Color>
    <Color x:Key="SystemAccentColorLight3">#C6FF7A</Color>
    <Color x:Key="SystemAccentColorDark1">#55A516</Color>
    <Color x:Key="SystemAccentColorDark2">#3F8510</Color>
    <Color x:Key="SystemAccentColorDark3">#2C650A</Color>
    <!-- Cores de destaque do sistema (SystemColors): os modelos do Fluent leem por estas chaves. -->
    <Color x:Key="{x:Static SystemColors.AccentColorKey}">#6CC51E</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight1Key}">#8EDB2C</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight2Key}">#A8EC4A</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight3Key}">#C6FF7A</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark1Key}">#55A516</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark2Key}">#3F8510</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark3Key}">#2C650A</Color>
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#A8EC4A"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#C6FF7A"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#A8EC4A"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6A8EC4A"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCA8EC4A"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#C6FF7A"/>
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#C6FF7A"/>
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#A8EC4A"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0B1A05"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#A2E640"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#B8F06A"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#24A2E640"/>
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#5CA2E640"/>
    <!-- Texto sobre o degradê verde: quase preto (branco fica ilegível sobre verde-limão). -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0B1A05"/>
    <SolidColorBrush x:Key="OnAccentSoftBrush" Color="#B30B1A05"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D4FF4F" Offset="0"/>
        <GradientStop Color="#A2E640" Offset="0.5"/>
        <GradientStop Color="#5FB51E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientTextBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D4FF4F" Offset="0"/>
        <GradientStop Color="#8EDB2C" Offset="1"/>
    </LinearGradientBrush>

    <!-- Fundo: quase preto levemente esverdeado, com dois brilhos verdes suaves. -->
    <Color x:Key="BgColor">#090C08</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#090C08"/>
    <RadialGradientBrush x:Key="BgGlow1Brush" Center="0.15,0" GradientOrigin="0.15,0" RadiusX="0.7" RadiusY="0.8">
        <GradientStop Color="#2B7CC72A" Offset="0"/>
        <GradientStop Color="#007CC72A" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BgGlow2Brush" Center="1,1" GradientOrigin="1,1" RadiusX="0.6" RadiusY="0.7">
        <GradientStop Color="#1FC6FF3D" Offset="0"/>
        <GradientStop Color="#00C6FF3D" Offset="1"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="SidebarBrush" Color="#990B0F0A"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="CardBrush" Color="#B3141A13"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1A2119"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SelectedItemBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#222A21"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#2B352A"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F8F2"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B6C2B2"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7D897A"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#224ADE80"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarnBgBrush" Color="#1FFBBF24"/>
    <SolidColorBrush x:Key="WarnBorderBrush" Color="#59FBBF24"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="#1F60A5FA"/>
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#4D60A5FA"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#93C5FD"/>

    <!-- Cartão do jogo em foco: degradê verde vivo com texto escuro. Sem jogo: verde acinzentado. -->
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C6FF3D" Offset="0"/>
        <GradientStop Color="#8EDB2C" Offset="0.5"/>
        <GradientStop Color="#4FAA1C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroIdleBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B9C7AE" Offset="0"/>
        <GradientStop Color="#7E9373" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="HeroShadowColor">#7CC72A</Color>

    <!-- Desenho do controle (lido pelo ControllerDiagram). -->
    <Color x:Key="DiagramBodyTopColor">#2A3128</Color>
    <Color x:Key="DiagramBodyBottomColor">#171C16</Color>
    <Color x:Key="DiagramStrokeColor">#3A4537</Color>
    <Color x:Key="DiagramButtonColor">#0C100B</Color>
    <Color x:Key="DiagramButtonTextColor">#F4F8F2</Color>
    <Color x:Key="DiagramRingTextColor">#B6C2B2</Color>
    <Color x:Key="DiagramRingColor">#343F31</Color>
    <Color x:Key="DiagramDisabledColor">#1F261E</Color>
    <Color x:Key="DiagramDisabledTextColor">#5A6657</Color>
    <Color x:Key="DiagramDecorColor">#121711</Color>
    <Color x:Key="DiagramDecorMarkColor">#7D897A</Color>
    <Color x:Key="DiagramPressedColor">#A2E640</Color>
    <Color x:Key="DiagramCustomColor">#FBBF24</Color>
    <Color x:Key="DiagramSelectedColor">#D4FF4F</Color>
    <RadialGradientBrush x:Key="DiagramStageBrush" RadiusX="0.6" RadiusY="0.6">
        <GradientStop Color="#267CC72A" Offset="0"/>
        <GradientStop Color="#007CC72A" Offset="1"/>
    </RadialGradientBrush>

    <!-- Aviso flutuante -->
    <SolidColorBrush x:Key="ToastBrush" Color="#F2121711"/>
</ResourceDictionary>
