<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema claro. Mesmas chaves de Colors.Dark.xaml. Sobre fundo claro, o verde dos textos/realces é mais escuro (contraste). -->

    <Color x:Key="AccentColor">#4C9A12</Color>

    <Color x:Key="SystemAccentColor">#4C9A12</Color>
    <Color x:Key="SystemAccentColorLight1">#6CC51E</Color>
    <Color x:Key="SystemAccentColorLight2">#8EDB2C</Color>
    <Color x:Key="SystemAccentColorLight3">#A8EC4A</Color>
    <Color x:Key="SystemAccentColorDark1">#3F8510</Color>
    <Color x:Key="SystemAccentColorDark2">#2F6E0C</Color>
    <Color x:Key="SystemAccentColorDark3">#225508</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorKey}">#4C9A12</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight1Key}">#6CC51E</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight2Key}">#8EDB2C</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight3Key}">#A8EC4A</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark1Key}">#3F8510</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark2Key}">#2F6E0C</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark3Key}">#225508</Color>
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#3F8510"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#4C9A12"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#3F8510"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E63F8510"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC3F8510"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#2F6E0C"/>
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#225508"/>
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#3F8510"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#4C9A12"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#2F6E0C"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E8EDB2C"/>
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#664C9A12"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0B1A05"/>
    <SolidColorBrush x:Key="OnAccentSoftBrush" Color="#B30B1A05"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C6FF3D" Offset="0"/>
        <GradientStop Color="#8EDB2C" Offset="0.5"/>
        <GradientStop Color="#5FB51E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientTextBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4C9A12" Offset="0"/>
        <GradientStop Color="#2F6E0C" Offset="1"/>
    </LinearGradientBrush>

    <Color x:Key="BgColor">#F3F7EF</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#F3F7EF"/>
    <RadialGradientBrush x:Key="BgGlow1Brush" Center="0.15,0" GradientOrigin="0.15,0" RadiusX="0.7" RadiusY="0.8">
        <GradientStop Color="#40C6FF3D" Offset="0"/>
        <GradientStop Color="#00C6FF3D" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BgGlow2Brush" Center="1,1" GradientOrigin="1,1" RadiusX="0.6" RadiusY="0.7">
        <GradientStop Color="#2E8EDB2C" Offset="0"/>
        <GradientStop Color="#008EDB2C" Offset="1"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="SidebarBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#14162B0E"/>
    <SolidColorBrush x:Key="CardBrush" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#14162B0E"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#EEF3EA"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#1A162B0E"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0A162B0E"/>
    <SolidColorBrush x:Key="SelectedItemBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#E6EDE1"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#D5DECF"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#121A0F"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#44503F"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7E8A79"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1F16A34A"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="WarnBgBrush" Color="#1AF59E0B"/>
    <SolidColorBrush x:Key="WarnBorderBrush" Color="#59F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="#143B82F6"/>
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#403B82F6"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#1D4ED8"/>

    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C6FF3D" Offset="0"/>
        <GradientStop Color="#8EDB2C" Offset="0.5"/>
        <GradientStop Color="#4FAA1C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroIdleBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DDE6D6" Offset="0"/>
        <GradientStop Color="#A9B89E" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="HeroShadowColor">#8EDB2C</Color>

    <!-- Desenho: controle branco com botões escuros (como a versão branca do Ultimate 2). -->
    <Color x:Key="DiagramBodyTopColor">#FFFFFF</Color>
    <Color x:Key="DiagramBodyBottomColor">#E3E9DE</Color>
    <Color x:Key="DiagramStrokeColor">#CAD3C4</Color>
    <Color x:Key="DiagramButtonColor">#232A20</Color>
    <Color x:Key="DiagramButtonTextColor">#FFFFFF</Color>
    <Color x:Key="DiagramRingTextColor">#55604F</Color>
    <Color x:Key="DiagramRingColor">#D1DACB</Color>
    <Color x:Key="DiagramDisabledColor">#EAEFE6</Color>
    <Color x:Key="DiagramDisabledTextColor">#A3AE9D</Color>
    <Color x:Key="DiagramDecorColor">#D6DED0</Color>
    <Color x:Key="DiagramDecorMarkColor">#748070</Color>
    <Color x:Key="DiagramPressedColor">#6CC51E</Color>
    <Color x:Key="DiagramCustomColor">#F59E0B</Color>
    <Color x:Key="DiagramSelectedColor">#4C9A12</Color>
    <RadialGradientBrush x:Key="DiagramStageBrush" RadiusX="0.6" RadiusY="0.6">
        <GradientStop Color="#2E8EDB2C" Offset="0"/>
        <GradientStop Color="#008EDB2C" Offset="1"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="ToastBrush" Color="#F7FFFFFF"/>
</ResourceDictionary>
