<Application x:Class="Virtual8BitDo.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark"
             ShutdownMode="OnExplicitShutdown">
    <!-- ThemeMode="Dark": tema Fluent (visual Windows 11) sempre escuro, independente do Windows.
         Sem StartupUri: a janela é criada em App.xaml.cs, depois de checar se já há outra cópia aberta.
         OnExplicitShutdown: fechar/esconder a janela não encerra o app (ele fica na bandeja). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
